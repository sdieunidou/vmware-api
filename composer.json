{
    "name": "mtxserv/vmware-api",
    "description": "PHP library for interacting with the VMware Rest API.",
    "keywords": [
        "vsphere",
        "sdk",
        "automation",
        "api"
    ],
    "homepage": "https://github.com/mTxServ/vmware-api",
    "authors": [
        {
            "name": "mTxServ",
            "email": "contact@mtxserv.com",
            "homepage": "https://mtxserv.com"
        }
    ],
    "type": "library",
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "VMware\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VMware\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
